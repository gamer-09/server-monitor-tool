# Server
PORT=3000

# When set, kill requests (POST /servers/kill) require: Authorization: Bearer <ADMIN_TOKEN>
# When empty, kill requests are allowed from localhost only.
ADMIN_TOKEN=

# Optional GitHub personal access token for repo management tasks
# (e.g. updating the repo description via the GitHub API).
# Not used by the app at runtime. Never commit the real value — keep it in .env only.
GITHUB_TOKEN=
